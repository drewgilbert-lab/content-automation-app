# =============================================================================
# Content Engine — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.

# --- Weaviate Cloud (Required) ---
WEAVIATE_URL=                    # REST endpoint from Weaviate Cloud console
WEAVIATE_API_KEY=                # Admin API key (content-engine-admin user) — full CRUD access

# --- Weaviate Scoped Users (Group K / Groups J+L) ---
# Created via Weaviate Cloud user management (v1.30+) for defense-in-depth.
# See docs/TECH_DECISIONS.md ADR-014.
# WEAVIATE_READER_API_KEY=       # Read-only user (content-engine-api-reader) — used by /api/v1/ routes
# WEAVIATE_MCP_API_KEY=          # MCP user (content-engine-mcp) — used by MCP server

# --- Anthropic (Required) ---
ANTHROPIC_API_KEY=               # From console.anthropic.com

# --- Redis (Upstash — Required for rate limiting + upload session persistence) ---
UPSTASH_REDIS_REST_URL=          # From Upstash console (Redis REST API URL)
UPSTASH_REDIS_REST_TOKEN=        # From Upstash console (Redis REST API token)
#                                # Used by: /api/v1/ rate limiting (lib/rate-limit.ts),
#                                #          bulk upload session persistence (lib/upload-session.ts)
#                                # Without these, rate limiting is disabled and upload sessions use in-memory fallback

# --- CORS (Group K — Optional) ---
# ALLOWED_ORIGINS=               # Comma-separated origins for /api/v1/ CORS (e.g. https://app.example.com)

# --- MCP Server URL (Optional — shown in Connected Systems UI) ---
# NEXT_PUBLIC_MCP_SERVER_URL=    # Deployed MCP server URL (e.g. https://content-automation-app.up.railway.app)
#                                # Shown on connection creation success screen and detail page for MCP-enabled keys

# --- Authentication (Group W — Required for user sign-in) ---
GOOGLE_CLIENT_ID=               # From Google Cloud Console (OAuth 2.0 client)
GOOGLE_CLIENT_SECRET=           # From Google Cloud Console (OAuth 2.0 client)
NEXTAUTH_URL=                   # Full URL of the app (e.g. http://localhost:3000)
NEXTAUTH_SECRET=                # Random secret for JWT encryption (generate with: openssl rand -base64 32)

# --- Auth Domain Restriction (Group W — Optional) ---
# ALLOWED_DOMAINS=              # Comma-separated Google Workspace domains (e.g. company.com,partner.com)
# ALLOWED_EMAILS=               # Comma-separated individual email addresses allowed to sign in
# ADMIN_EMAIL=                  # Email that always gets admin role on first sign-in (overrides first-user-is-admin)

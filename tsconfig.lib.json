{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./lib",
    "rootDir": "./lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": [
    "lib/weaviate.ts",
    "lib/connection-types.ts",
    "lib/knowledge-types.ts",
    "lib/knowledge.ts",
    "lib/skill-types.ts",
    "lib/skills.ts",
    "lib/submission-types.ts",
    "lib/submissions.ts",
    "lib/dashboard.ts",
    "lib/api-auth.ts"
  ],
  "exclude": ["node_modules", "__tests__"]
}

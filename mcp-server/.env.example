# Content Engine MCP Server — Environment Variables
# Copy to .env and fill in values for local development.

# --- Weaviate Cloud (Required) ---
WEAVIATE_URL=                    # REST endpoint from Weaviate Cloud console
WEAVIATE_API_KEY=                # Weaviate API key (admin or scoped MCP user)

# --- Transport (Optional) ---
TRANSPORT=stdio                  # "stdio" (default) or "http"
PORT=3100                        # HTTP port (only used when TRANSPORT=http)
